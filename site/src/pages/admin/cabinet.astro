          <option>VK</option><option>Telegram</option><option>YouTube</option><option>Дзен</option>
        </select>
        <input name="link" placeholder="Ссылка" />
        <input name="members" type="number" min="0" placeholder="Подписчиков" />
        <input name="posts" type="number" min="0" placeholder="Публикаций" />
        <input name="engagement" type="number" min="0" step="0.1" placeholder="Вовлечённость, %" />
        <select name="status">
          <option value="active">Ведётся</option><option value="paused">Пауза</option>
          <option value="closed">Закрыта</option>
        </select>
        <div class="f-actions"><button class="btn" type="submit">Добавить группу</button></div>
      </form>
      <div class="tbl-wrap"><table class="tbl">
        <thead><tr><th>Группа</th><th>Сеть</th><th class="num">Подписчиков</th><th class="num">Публикаций</th>
          <th class="num">Вовлечённость</th><th>Статус</th><th></th></tr></thead>
        <tbody>${cache.social.map((g) => `<tr data-id="${esc(g.id)}">
          <td><b>${esc(g.name)}</b>${g.link ? `<div class="muted">${esc(g.link)}</div>` : ''}</td>
          <td>${esc(g.net)}</td>
          <td class="num"><input class="cell num" data-field="members" type="number" value="${g.members}" /></td>
          <td class="num"><input class="cell num" data-field="posts" type="number" value="${g.posts}" /></td>
          <td class="num"><input class="cell num" data-field="engagement" type="number" step="0.1" value="${g.engagement}" /></td>
          <td>${badge(SOCIAL_STATUS[g.status] ? SOCIAL_STATUS[g.status].t : g.status,
                     SOCIAL_STATUS[g.status] ? SOCIAL_STATUS[g.status].c : 'var(--tx-3)')}</td>
          <td style="text-align:right"><button class="icon-btn del" data-soc-del="${esc(g.id)}" title="Удалить">×</button></td>
        </tr>`).join('') || '<tr><td colspan="7" class="empty">Групп нет</td></tr>'}</tbody>
      </table></div>`;

    $('#soc-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const body = {};
      new FormData(e.currentTarget).forEach((v, k) => { if (v !== '') body[k] = v; });
      await api('/social', { method: 'POST', body: JSON.stringify(body) }).catch(() => {});
      viewSocial();
    });
    $$('[data-field]').forEach((el) => {
      el.addEventListener('change', async () => {
        const tr = el.closest('tr');
        const body = {};
        body[el.dataset.field] = Number(el.value) || 0;
        await api('/social/' + tr.dataset.id, { method: 'PATCH', body: JSON.stringify(body) }).catch(() => {});
        el.classList.add('saved');
        setTimeout(() => el.classList.remove('saved'), 900);
      });
    });
    $$('[data-soc-del]').forEach((b) => {
      b.addEventListener('click', async () => {
        if (!confirm('Удалить группу?')) return;
        await api('/social/' + b.dataset.socDel, { method: 'DELETE' }).catch(() => {});
        viewSocial();
      });
    });
  }

  // ── ВЫГРУЗКА В CSV ──
  // Разделитель «;» и BOM: без этого русский Excel открывает файл одной колонкой
  // и кракозябрами вместо кириллицы. Проверено на живых людях
  function downloadCsv(filename, head, rows) {
    const cell = (v) => '"' + String(v === null || v === undefined ? '' : v).replace(/"/g, '""') + '"';
    const csv = [head].concat(rows).map((line) => line.map(cell).join(';')).join('\r\n');
    const blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    // Ссылку и blob снимаем сразу: в файле персданные, держать их в памяти незачем
    setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 0);
  }

  // ─────────── СТАТИСТИКА ───────────
  // Три источника: Метрика, Google Ads, ВКонтакте. Показываем то, что реально пришло.
  // Ключей нет — карточка честно говорит об этом и перечисляет нужные переменные.
  // Нарисовать красивые нули было бы проще, но тогда никто не узнает, что данные не идут
  const STAT_META = {
    ym: { title: 'Яндекс.Метрика', char: 'Я', color: '#FC3F1D', unit: 'визитов' },
    gads: { title: 'Google Ads', char: 'G', color: '#34A853', unit: '₽ расход' },
    vk: { title: 'ВКонтакте', char: 'VK', color: '#0077FF', unit: 'подписчиков' },
  };

  function statSeries(s) {
    const arr = (s.series || []).map((d) => Number(d.value) || 0);
    // Ряд из одних нулей рисуется как прямая по нижнему краю — это выглядит как ошибка.
    // Поднимаем на единицу, чтобы линия была ровной, но видимой
    return arr.some((v) => v > 0) ? arr : arr.map(() => 1);
  }

  function statFacts(key, s) {
    // Ответ старый или неполный — не роняем экран в белый. Недостающее показываем прочерком
    const t = s.totals || {};
    const n = (v, tail) => (v === null || v === undefined || Number.isNaN(Number(v)))
      ? '—' : Number(v).toLocaleString('ru-RU') + (tail || '');
    if (key === 'ym') return [
      ['Визиты', n(t.visits)],
      ['Посетители', n(t.users)],
      ['Просмотры', n(t.pageviews)],
      ['Отказы', t.bounce === undefined ? '—' : t.bounce + '%'],
    ];
    if (key === 'gads') return [
      ['Расход', n(t.cost, ' ₽')],
      ['Клики', n(t.clicks)],
      ['Показы', n(t.impressions)],
      ['Цена клика', n(t.cpc, ' ₽')],
    ];
    return [
      ['Подписчики', n(t.members)],
      ['Охват за 30 дней', s.reachMissing ? '—' : n(t.reach)],
      ['Охват в день', s.reachMissing ? '—' : n(t.reachAvg)],
      ['Сообщество', s.group || '—'],
    ];
  }

  function statCard(key, box) {
    const m = STAT_META[key];
    const s = box && box.data;
    const head = `<div class="sc-head">
        <span class="sc-badge" style="background:${m.color}">${m.char}</span>
        <span class="sc-title">${m.title}</span>
        ${s && box.fetched_at ? `<span class="sc-when">${esc(fmtDate(box.fetched_at))}</span>` : ''}
      </div>`;

    if (!s) {
      return `<div class="sc-card">${head}
        <p class="hint" style="margin:12px 0 6px">Данных ещё нет — обновите кнопкой сверху.</p></div>`;
    }
    if (!s.ok) {
      const need = (s.need || []).map((n) => `<code>${esc(n)}</code>`).join(', ');
      return `<div class="sc-card">${head}
        <p class="stat-off">${esc(s.hint || s.error || 'источник отключён')}</p>
        ${need ? `<p class="hint" style="margin:0">В <code>.env</code> нужны: ${need}</p>` : ''}</div>`;
    }
    const facts = statFacts(key, s).map(([k, v]) => `
      <div class="sc-fact"><span>${k}</span><b>${esc(v)}</b></div>`).join('');
    return `<div class="sc-card">${head}
      <div class="sc-facts">${facts}</div>
      <div class="sc-chart">${sparkline(statSeries(s), m.color, 400, 80)}</div>
      <p class="hint" style="margin:6px 0 0">${esc(s.period || '')}${
        s.counter ? ' · счётчик ' + esc(s.counter) : ''}${
        s.customer ? ' · ' + esc(s.customer) : ''}</p></div>`;
  }

  async function viewStats() {
    $('#top-actions').innerHTML = '<button class="btn" id="stats-btn" type="button">Обновить данные</button>';
    $('#content').innerHTML = '<div id="stats-cards"><p class="hint">Загрузка…</p></div>';
    await drawStats();

    $('#stats-btn').addEventListener('click', async () => {
      const btn = $('#stats-btn');
      btn.disabled = true;
      btn.textContent = 'Опрашиваю сервисы…';
      // Три запроса параллельно: последовательно ждать до 45 секунд, если у всех таймаут
      await Promise.all(['ym', 'gads', 'vk'].map((k) =>
        api('/stats/refresh?source=' + k, { method: 'POST' }).catch(() => null)));
      btn.disabled = false;
      btn.textContent = 'Обновить данные';
      await drawStats();
      refreshCounters();
    });
  }

  async function drawStats() {
    const box = $('#stats-cards');
    if (!box) return;
    const r = await api('/stats').catch((e) => ({ fail: String((e && e.message) || 'ошибка') }));
    if (r.fail) {
      box.innerHTML = `<div class="errbox"><b>Не удалось загрузить статистику.</b>
        <p class="hint">Ответ сервера: ${esc(r.fail)}</p></div>`;
      return;
    }
    const src = r.sources || {};
    box.innerHTML = '<div class="stats-grid">' +
      ['ym', 'gads', 'vk'].map((k) => statCard(k, src[k])).join('') + '</div>' +
      `<p class="hint" style="margin-top:14px">Цифры кэшируются: запросы к сервисам уходят только по кнопке.
        Лимиты API не резиновые, а дашборд открывают чаще, чем меняются данные.</p>`;
  }

  // ─────────── ПОЛЬЗОВАТЕЛИ ───────────
  async function viewUsers() {
    const res = await api('/users').catch((e) => ({ items: [], fail: String((e && e.message) || 'ошибка') }));
    cache.users = res.items || [];
    $('#top-actions').innerHTML = '<button class="btn" id="user-add" type="button">Добавить пользователя</button>';

    $('#content').innerHTML = `
      ${res.fail ? `<div class="errbox"><b>Не удалось загрузить пользователей.</b>
        <p class="hint">Ответ сервера: ${esc(res.fail)}</p></div>` : ''}
      <form class="formbox" id="user-form" hidden>
        <input name="email" type="email" placeholder="Почта" required />
        <input name="name" placeholder="Имя" />
        <input name="password" type="password" placeholder="Пароль, минимум 12 символов" required minlength="12" />
        <select name="role">
          ${Object.keys(ROLES_RU).map((k) => `<option value="${k}">${ROLES_RU[k]}</option>`).join('')}
        </select>
        <div class="f-actions">
          <button class="btn" type="submit">Создать</button>
          <button class="btn btn--ghost" type="button" id="user-cancel">Отмена</button>
        </div>
      </form>
      <div class="tbl-wrap"><table class="tbl">
        <thead><tr><th>Имя</th><th>Почта</th><th>Роль</th><th>Активен</th><th>Последний вход</th><th></th></tr></thead>
        <tbody>${cache.users.map((u) => `<tr data-id="${esc(u.id)}">
          <td><b>${esc(u.name) || '—'}</b></td>
          <td class="muted">${esc(u.email)}</td>
          <td><select class="cell" data-u-role>
            ${Object.keys(ROLES_RU).map((k) =>
              `<option value="${k}"${u.role === k ? ' selected' : ''}>${ROLES_RU[k]}</option>`).join('')}
          </select></td>
          <td><input type="checkbox" data-u-active ${u.active ? 'checked' : ''} /></td>
          <td class="muted nowrap">${esc(fmtDate(u.last_login))}</td>
          <td style="text-align:right">
            <button class="btn btn--ghost btn--sm" data-u-pass="${esc(u.id)}" type="button">Сменить пароль</button>
          </td>
        </tr>`).join('') || '<tr><td colspan="6" class="empty">Пользователей нет</td></tr>'}</tbody>
      </table></div>
      <p class="hint" style="margin-top:12px">Саморегистрации нет: пользователей заводит только администратор.
        При смене пароля все сессии этого человека закрываются.</p>`;

    $('#user-add').addEventListener('click', () => {
      const f = $('#user-form');
      f.hidden = !f.hidden;
      if (!f.hidden) $('[name=email]', f).focus();
    });
    $('#user-cancel').addEventListener('click', () => { $('#user-form').hidden = true; });
    $('#user-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const body = {};
      new FormData(e.currentTarget).forEach((v, k) => { if (v !== '') body[k] = v; });
      const r = await api('/users', { method: 'POST', body: JSON.stringify(body) }).catch(() => null);
      if (!r || !r.ok) {
        const map = {
          email_taken: 'Такая почта уже занята', password_too_short: 'Пароль короче 12 символов',
          bad_email: 'Проверьте адрес почты',
        };
        toast(map[r && r.error] || 'Не удалось создать пользователя');
        return;
      }
      viewUsers();
    });
    $$('[data-u-role]').forEach((sel) => {
      sel.addEventListener('change', async () => {
        const r = await api('/users/' + sel.closest('tr').dataset.id, {
          method: 'PATCH', body: JSON.stringify({ role: sel.value }),
        }).catch(() => null);
        if (!r || !r.ok) {
          toast(r && r.error === 'last_admin' ? 'Это последний администратор — понизить нельзя'
            : r && r.error === 'cannot_demote_self' ? 'Нельзя снять роль с самого себя' : 'Не удалось изменить роль');
          viewUsers();
        }
      });
    });
    $$('[data-u-active]').forEach((cb) => {
      cb.addEventListener('change', async () => {
        const r = await api('/users/' + cb.closest('tr').dataset.id, {
          method: 'PATCH', body: JSON.stringify({ active: cb.checked ? 1 : 0 }),
        }).catch(() => null);
        if (!r || !r.ok) { toast('Не удалось изменить доступ'); viewUsers(); }
      });
    });
    $$('[data-u-pass]').forEach((b) => {
      b.addEventListener('click', async () => {
        const pass = prompt('Новый пароль (минимум 12 символов):');
        if (!pass) return;
        const r = await api('/users/' + b.dataset.uPass, {
          method: 'PATCH', body: JSON.stringify({ password: pass }),
        }).catch(() => null);
        toast(r && r.ok ? 'Пароль изменён, сессии закрыты' : 'Не удалось: ' + ((r && r.error) || 'нет ответа'));
      });
    });
  }

  // ─────────── ЖУРНАЛ ───────────
  async function viewAudit() {
    const res = await api('/audit?limit=200').catch(() => ({ items: [] }));
    const items = res.items || [];
    $('#content').innerHTML = `<p class="hint">Кто и что менял. Пишутся только значимые события:
      правка заявок, кадров, выплат, пользователей и медиа.</p>
      <div class="tbl-wrap"><table class="tbl">
        <thead><tr><th>Когда</th><th>Кто</th><th>Действие</th><th>Объект</th><th>Детали</th></tr></thead>
        <tbody>${items.map((a) => `<tr>
          <td class="nowrap muted">${esc(fmtDate(a.at))}</td>
          <td>${esc(a.actor) || '—'}</td>
          <td><code style="font-size:12px">${esc(a.action)}</code></td>
          <td class="muted">${esc(a.target) ? esc(String(a.target).slice(0, 8)) + '…' : '—'}</td>
          <td class="muted">${esc(a.details) || '—'}</td>
        </tr>`).join('') || '<tr><td colspan="5" class="empty">Журнал пуст</td></tr>'}</tbody>
      </table></div>`;
  }

  // ─────────── РЕЕСТР ЭКРАНОВ ───────────
  const VIEWS = {
    overview: viewOverview,
    leads: viewLeads,
    apps: viewApps,
    vacancies: viewVacancies,
    employees: viewEmployees,
    payments: viewPayments,
    texts: viewTexts,
    media: viewMedia,
    social: viewSocial,
    stats: viewStats,
    users: viewUsers,
    audit: viewAudit,
  };

  // ─────────── ПЛАШКА ───────────
  let toastTimer;
  function toast(msg) {
    const el = $('#toast');
    el.textContent = msg;
    el.hidden = false;
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => { el.hidden = true; }, 5000);
  }
  $('#toast').addEventListener('click', () => { $('#toast').hidden = true; });

  // ─────────── СТАРТ ───────────
  async function boot() {
    const res = await api('/me').catch(() => ({ ok: false }));
    me = res.ok ? res.user : null;
    renderAuth();
  }

  initTheme();
  boot();
})();

  </script>
</body>
</html>

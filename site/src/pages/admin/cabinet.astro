  // ─────────── СОЦСЕТИ ───────────
  // Пока это витрина на демо-цифрах: реальные значения из API ВК и Телеграма требуют
  // токенов и согласований. Но структура и графики настоящие — когда появится источник,
  // достаточно заменить buildDemoSeries на ответ API, верстка не изменится
  const SOCIAL_DEMO = {
    VK: { color: '#0077FF', base: 4820, growth: 0.012 },
    Telegram: { color: '#2AABEE', base: 2150, growth: 0.018 },
    YouTube: { color: '#FF0000', base: 9800, growth: 0.006 },
    Дзен: { color: '#000000', base: 1400, growth: 0.009 },
    'Яндекс.Метрика': { color: '#FC3F1D', base: 12400, growth: 0.011 },
    'Google Analytics': { color: '#34A853', base: 18700, growth: 0.007 },
  };

  // Детерминированный «шум»: без Math.random график не дёргается при каждой перерисовке,
  // и один и тот же период выглядит одинаково у всех
  function buildDemoSeries(base, growth, days) {
    const out = [];
    let v = base;
    for (let i = days; i >= 0; i--) {
      const wave = Math.sin(i / 3.1) * 0.004 + Math.cos(i / 7.3) * 0.003;
      v = Math.round(v * (1 + growth / days + wave));
      out.push(v);
    }
    return out;
  }

  // Мини-график на SVG. Библиотеки не тащим: тут нужна одна ломаная на 30 точек
  function sparkline(values, color, w, h) {
    w = w || 260; h = h || 64;
    if (!values.length) return '';
    const min = Math.min.apply(null, values);
    const max = Math.max.apply(null, values);
    const span = max - min || 1;
    const step = w / (values.length - 1 || 1);
    const pts = values.map((v, i) => {
      const x = Math.round(i * step * 100) / 100;
      const y = Math.round((h - ((v - min) / span) * (h - 8) - 4) * 100) / 100;
      return x + ',' + y;
    });
    const area = '0,' + h + ' ' + pts.join(' ') + ' ' + w + ',' + h;
    return '<svg viewBox="0 0 ' + w + ' ' + h + '" preserveAspectRatio="none" style="width:100%;height:' + h + 'px;display:block">' +
      '<polygon points="' + area + '" fill="' + color + '" opacity="0.10"/>' +
      '<polyline points="' + pts.join(' ') + '" fill="none" stroke="' + color + '" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>' +
      '</svg>';
  }

  async function viewSocial() {
    const res = await api('/social').catch(() => ({ items: [] }));
    cache.social = res.items || [];

    // Карточки-заглушки: соцсети + поисковики. Тут только цифры для наглядности
    const demoCards = ['VK', 'Telegram', 'YouTube', 'Дзен', 'Яндекс.Метрика', 'Google Analytics'].map((net) => {
      const cfg = SOCIAL_DEMO[net];
      const series = buildDemoSeries(cfg.base, cfg.growth, 30);
      const now = series[series.length - 1];
      const was = series[0];
      const delta = ((now - was) / was) * 100;
      const sign = delta >= 0 ? '+' : '';
      return '<div class="kpi">' +
        '<div class="k-label" style="display:flex;align-items:center;gap:7px">' +
        '<span style="width:9px;height:9px;border-radius:50%;background:' + cfg.color + ';display:inline-block"></span>' +
        net + ' <span style="font-size:10px;color:var(--tx-3);text-transform:none">демо</span></div>' +
        '<div class="k-val">' + now.toLocaleString('ru-RU') + '</div>' +
        '<div class="k-sub" style="color:' + (delta >= 0 ? 'var(--ok)' : 'var(--bad)') + '">' +
        sign + delta.toFixed(1) + '% за 30 дней</div>' +
        sparkline(series, cfg.color) + '</div>';
    }).join('');

    $('#content').innerHTML = `
      <p class="hint">Цифры на карточках — демонстрационные: нужны токены ВК, Телеграма и доступ
        к счётчикам. Список групп ниже ведётся вручную и сохраняется.</p>
      <div class="kpis" style="grid-template-columns:repeat(auto-fit,minmax(240px,1fr))">${demoCards}</div>

      <h2 style="font-size:16px;margin:26px 0 12px">Группы</h2>

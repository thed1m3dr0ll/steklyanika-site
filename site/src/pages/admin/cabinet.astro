---
// ═══════════════════════════════════════════════════════════════════════════════
//  СТРАНИЦА          cabinet.astro · CRM: заявки, HR, маркетинг, админ
// ═══════════════════════════════════════════════════════════════════════════════
//
//  КАРТА ФАЙЛА — блоки:
//
//  1   ДАННЫЕ         импорты
//  2   РАЗМЕТКА       вход, каркас (сайдбар + топбар), все экраны
//  3   СТИЛИ          темы (6 штук), каркас, таблицы, канбан, карточки
//  4   СКРИПТ         авторизация, загрузка данных, рендер, действия
//
//  Страница самодостаточная: свой <head>, без Base. Причина — у CRM своя оболочка
//  с боковым меню и топбаром. Шапка публичного сайта тут только мешает:
//  человек в кабинете не должен уезжать на «Проекты», промахнувшись мимо ссылки.
//
//  ВАЖНО: страница статическая, данные тянет с /api/admin/*. Ручки проверяют сессию сами.
//  Не вздумай вшивать данные в HTML при сборке — это утечка персданных в публичный файл.

// prerender держим ВНУТРИ шапки. Если оставить его после закрывающего ---,
// Astro решит, что это обычный текст, и напечатает строку прямо на странице.
// Именно так и случилось: строка висела в углу кабинета
export const prerender = true;
---

<html lang="ru" data-theme="apple">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Кабинет</title>
  <link rel="icon" href="/favicon.png" />
  <style is:inline>
    /* ═══════════════════════════════════════════════════════════════
       ТЕМЫ. Шесть палитр на CSS-переменных: меняем data-theme на <html>,
       и весь интерфейс перекрашивается. Ни одного хардкода цвета ниже
       за пределами этого блока — иначе тема перестанет работать
       ═══════════════════════════════════════════════════════════════ */
    :root, html[data-theme="apple"] {
      --font-sans: -apple-system, BlinkMacSystemFont, 'CeraPro', 'SF Pro Text', 'Inter', 'Segoe UI', sans-serif;
      --font-mono: ui-monospace, SFMono-Regular, Menlo, monospace;
      --bg-app: #F5F5F7;
      --bg-app-gradient: radial-gradient(1200px 500px at 15% -10%, rgba(0,113,227,.055), transparent 60%),
                         radial-gradient(900px 420px at 90% -5%, rgba(99,102,241,.045), transparent 55%), #F5F5F7;
      --bg-surface: #FFFFFF; --bg-surface-2: #F9FAFB; --bg-surface-3: #F1F3F6;
      --bg-col: rgba(235,238,244,.62); --bg-topbar: rgba(245,245,247,.78);
      --tx-1: #111318; --tx-2: #525866; --tx-3: #868C98;
      --bd-1: rgba(17,24,39,.075); --bd-2: rgba(17,24,39,.13);
      --accent: #0071E3; --accent-soft: rgba(0,113,227,.09);
      --sb-bg: rgba(255,255,255,.82); --sb-border: rgba(17,24,39,.07);
      --sb-text: #272B34; --sb-muted: #767D8C; --sb-hover: rgba(17,24,39,.045);
      --sb-active-bg: rgba(0,113,227,.10); --sb-active-text: #0066CC;
      --r-card: 16px; --sh-card: 0 1px 2px rgba(15,23,42,.035), 0 8px 24px -12px rgba(15,23,42,.065);
      --ok: #059669; --warn: #B45309; --bad: #DC2626; --info: #2563EB;
    }
    html[data-theme="bitrix"] {
      --bg-app: #E6F0F9; --bg-app-gradient: linear-gradient(135deg,#DCEEFB 0%,#EAF2F9 42%,#E5ECF7 75%,#DFF0FA 100%);
      --bg-surface: #FFFFFF; --bg-surface-2: #F6FAFD; --bg-surface-3: #EBF3FA;
      --bg-col: rgba(226,238,250,.7); --bg-topbar: rgba(230,240,249,.82);
      --tx-1: #1F2A37; --tx-2: #5A6678; --tx-3: #8A94A6;
      --bd-1: rgba(46,139,255,.14); --bd-2: rgba(46,139,255,.26);
      --accent: #2E8BFF; --accent-soft: rgba(46,139,255,.10);
      --sb-bg: rgba(255,255,255,.75); --sb-border: rgba(46,139,255,.18);
      --sb-text: #233040; --sb-muted: #6B7A91; --sb-hover: rgba(46,139,255,.06);
      --sb-active-bg: rgba(46,139,255,.12); --sb-active-text: #2E8BFF;
    }
    html[data-theme="erp"] {
      --bg-app: #F7F8FA; --bg-app-gradient: #F7F8FA;
      --bg-surface: #FFFFFF; --bg-surface-2: #F4F6F8; --bg-surface-3: #EDF0F4;
      --bg-col: #EEF1F5; --bg-topbar: rgba(247,248,250,.9);
      --tx-1: #0F1B2D; --tx-2: #4A5568; --tx-3: #8B94A3;
      --bd-1: #E5E7EB; --bd-2: #D1D5DB;
      --accent: #1A56DB; --accent-soft: rgba(26,86,219,.08);
      --sb-bg: #FFFFFF; --sb-border: #E4E7EB; --sb-text: #1F2937; --sb-muted: #6B7280;
      --sb-hover: #F3F4F6; --sb-active-bg: #E8F0FE; --sb-active-text: #1A56DB;
      --r-card: 8px; --sh-card: 0 1px 3px rgba(15,23,42,.06);
    }
    /* Тема ВК: фирменный синий и светлый фон, как в вебе соцсети.
       Нужна потому, что маркетолог весь день смотрит на группы — пусть и кабинет будет «свой» */
    html[data-theme="vk"] {
      --bg-app: #EDEEF0; --bg-app-gradient: #EDEEF0;
      --bg-surface: #FFFFFF; --bg-surface-2: #F0F2F5; --bg-surface-3: #E5E8EC;
      --bg-col: rgba(228,232,238,.75); --bg-topbar: rgba(237,238,240,.85);
      --tx-1: #000000; --tx-2: #656565; --tx-3: #939393;
      --bd-1: rgba(0,0,0,.08); --bd-2: rgba(0,0,0,.16);
      --accent: #0077FF; --accent-soft: rgba(0,119,255,.10);
      --sb-bg: #FFFFFF; --sb-border: rgba(0,0,0,.08);
      --sb-text: #000000; --sb-muted: #818C99; --sb-hover: #F0F2F5;
      --sb-active-bg: #E5EBF1; --sb-active-text: #0077FF;
      --r-card: 12px; --sh-card: 0 1px 2px rgba(0,0,0,.06);
      --ok: #4BB34B; --warn: #FFA000; --bad: #E64646; --info: #0077FF;
    }
    html[data-theme="skatinov"], html[data-theme="dark"] {
      --bg-app: #07080D;
      --bg-app-gradient: radial-gradient(1200px 700px at 12% -8%, rgba(127,209,255,.12), transparent 60%),
                         radial-gradient(1100px 700px at 100% 0%, rgba(184,155,255,.12), transparent 55%), #07080D;
      --bg-surface: #0E1016; --bg-surface-2: #12141B; --bg-surface-3: #1A1D26;
      --bg-col: rgba(26,29,38,.6); --bg-topbar: rgba(14,16,22,.82);
      --tx-1: #E8ECF4; --tx-2: #9AA3B2; --tx-3: #6B7280;
      --accent: #7fd1ff; --accent-soft: rgba(127,209,255,.12);
      --sb-bg: rgba(14,16,22,.88); --sb-border: rgba(255,255,255,.08);
      --sb-text: #D8DEE9; --sb-muted: #7C8595; --sb-hover: rgba(255,255,255,.05);
      --sb-active-bg: rgba(127,209,255,.12); --sb-active-text: #7fd1ff;
      --bd-1: rgba(255,255,255,.08); --bd-2: rgba(255,255,255,.14);
      --ok: #34D399; --warn: #FBBF24; --bad: #F87171; --info: #60A5FA;
    }

    @font-face { font-family: 'CeraPro'; src: url('/fonts/CeraPro-Regular.woff2') format('woff2'); font-weight: 400; font-display: swap; }
    @font-face { font-family: 'CeraPro'; src: url('/fonts/CeraPro-Medium.woff2') format('woff2'); font-weight: 500; font-display: swap; }
    @font-face { font-family: 'CeraPro'; src: url('/fonts/CeraPro-Bold.woff2') format('woff2'); font-weight: 700; font-display: swap; }

    *, *::before, *::after { box-sizing: border-box; }
    html, body { height: 100%; margin: 0; }
    body {
      font-family: var(--font-sans); color: var(--tx-1); background: var(--bg-app-gradient);
      background-attachment: fixed; -webkit-font-smoothing: antialiased;
      display: flex; min-height: 100vh;
    }
    button, input, select, textarea { font: inherit; color: inherit; }
    a { color: var(--accent); }

    /* ─────────── ВХОД ─────────── */
    .login { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center;
      padding: 24px; z-index: 500; background: var(--bg-app-gradient); }
    .login[hidden] { display: none; }
    .login form { width: 100%; max-width: 380px; background: var(--bg-surface); border: 1px solid var(--bd-1);
      border-radius: var(--r-card); padding: 32px; display: grid; gap: 14px; box-shadow: var(--sh-card); }
    .login h1 { margin: 0; font-size: 26px; }
    .login p.sub { margin: 0 0 6px; color: var(--tx-2); font-size: 14px; }
    .login label { display: grid; gap: 6px; font-size: 13px; color: var(--tx-2); }
    .login input { padding: 11px 13px; border: 1px solid var(--bd-2); border-radius: 9px;
      background: var(--bg-surface-2); color: var(--tx-1); }
    .login input:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
    .login .err { color: var(--bad); font-size: 13px; margin: 0; min-height: 1.1em; }

    /* ─────────── КАРКАС ─────────── */
    .shell { display: flex; width: 100%; }
    .shell[hidden] { display: none; }

    .sb { width: 252px; flex: 0 0 252px; background: var(--sb-bg); border-right: 1px solid var(--sb-border);
      backdrop-filter: blur(18px); display: flex; flex-direction: column; position: sticky; top: 0;
      height: 100vh; overflow-y: auto; z-index: 30; }
    .sb-brand { display: flex; align-items: center; gap: 10px; padding: 20px 18px 16px; }
    .sb-logo { width: 32px; height: 32px; border-radius: 9px; background: var(--accent); color: #fff;
      display: grid; place-items: center; font-weight: 700; font-size: 15px; flex: 0 0 32px; }
    .sb-name { font-weight: 700; font-size: 15px; color: var(--sb-text); line-height: 1.15; }
    .sb-name small { display: block; font-weight: 400; font-size: 11px; color: var(--sb-muted); margin-top: 2px; }

    .sb-section { padding: 14px 12px 4px; font-size: 10.5px; text-transform: uppercase;
      letter-spacing: .07em; color: var(--sb-muted); font-weight: 600; }
    .sb-item { display: flex; align-items: center; gap: 10px; width: calc(100% - 16px); margin: 2px 8px;
      padding: 9px 10px; border: 0; background: transparent; border-radius: 9px; cursor: pointer;
      color: var(--sb-text); font-size: 13.5px; text-align: left; transition: background .12s; }
    .sb-item:hover { background: var(--sb-hover); }
    .sb-item.on { background: var(--sb-active-bg); color: var(--sb-active-text); font-weight: 600; }
    .sb-item svg { width: 17px; height: 17px; flex: 0 0 17px; stroke: currentColor; fill: none; stroke-width: 1.9; }
    .sb-badge { margin-left: auto; font-size: 11px; font-weight: 700; background: var(--bad); color: #fff;
      border-radius: 999px; padding: 1px 7px; }
    .sb-badge[hidden] { display: none; }

    .sb-foot { margin-top: auto; padding: 14px 14px 16px; border-top: 1px solid var(--sb-border); }
    .sb-user { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
    .sb-avatar { width: 32px; height: 32px; border-radius: 50%; background: var(--accent-soft); color: var(--accent);
      display: grid; place-items: center; font-weight: 700; font-size: 13px; flex: 0 0 32px; }
    .sb-user .u-name { font-size: 13px; font-weight: 600; color: var(--sb-text); }
    .sb-user .u-role { font-size: 10.5px; color: var(--sb-muted); }

    .theme-switch { display: flex; gap: 4px; flex-wrap: wrap; }
    .theme-switch button { width: 22px; height: 22px; border-radius: 50%; border: 2px solid transparent;
      cursor: pointer; padding: 0; }
    .theme-switch button.on { border-color: var(--accent); }

    .main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
    .topbar { position: sticky; top: 0; z-index: 20; background: var(--bg-topbar); backdrop-filter: blur(18px);
      border-bottom: 1px solid var(--bd-1); padding: 14px 26px; display: flex; align-items: center; gap: 14px; }
    .topbar h1 { margin: 0; font-size: 19px; }
    .topbar .spacer { margin-left: auto; }
    .content { padding: 24px 26px 60px; }

    /* ─────────── КНОПКИ ─────────── */
    .btn { padding: 9px 15px; border-radius: 9px; border: 1px solid transparent; background: var(--accent);
      color: #fff; font-size: 13px; font-weight: 600; cursor: pointer; white-space: nowrap; }
    .btn:hover { filter: brightness(1.07); }
    .btn--ghost { background: var(--bg-surface-2); color: var(--tx-1); border-color: var(--bd-1); }
    .btn--ghost:hover { background: var(--bg-surface-3); }
    .btn--danger { background: var(--bad); }
    .btn--sm { padding: 6px 11px; font-size: 12px; }

    /* ─────────── KPI ─────────── */
    .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 14px; margin-bottom: 22px; }
    .kpi { background: var(--bg-surface); border: 1px solid var(--bd-1); border-radius: var(--r-card);
      padding: 16px 18px; box-shadow: var(--sh-card); }
    .kpi .k-label { font-size: 12px; color: var(--tx-3); text-transform: uppercase; letter-spacing: .05em; }
    .kpi .k-val { font-size: 26px; font-weight: 700; margin-top: 6px; letter-spacing: -.02em; }
    .kpi .k-sub { font-size: 12px; color: var(--tx-2); margin-top: 4px; }

    /* ─────────── ТАБЛИЦЫ ─────────── */
    .tbl-wrap { background: var(--bg-surface); border: 1px solid var(--bd-1); border-radius: var(--r-card);
      overflow: auto; box-shadow: var(--sh-card); }
    table.tbl { width: 100%; border-collapse: collapse; font-size: 13.5px; }
    .tbl th { text-align: left; padding: 11px 13px; font-size: 11px; text-transform: uppercase;
      letter-spacing: .05em; color: var(--tx-3); background: var(--bg-surface-2);
      border-bottom: 1px solid var(--bd-1); white-space: nowrap; position: sticky; top: 0; z-index: 1; }
    .tbl th[data-sort] { cursor: pointer; user-select: none; }
    .tbl th[data-sort]:hover { color: var(--tx-1); }
    .tbl th.sorted-desc::after { content: ' ↓'; color: var(--accent); }
    .tbl th.sorted-asc::after { content: ' ↑'; color: var(--accent); }
    .tbl td { padding: 9px 13px; border-bottom: 1px solid var(--bd-1); vertical-align: middle; }
    .tbl tr:last-child td { border-bottom: 0; }
    .tbl tbody tr:hover td { background: var(--bg-surface-2); }
    .tbl .empty { text-align: center; color: var(--tx-3); padding: 34px 13px; }
    .tbl .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .tbl .nowrap { white-space: nowrap; }
    .tbl .muted { color: var(--tx-3); font-size: 12px; }

    /* Правка прямо в ячейке: поле выглядит как текст, пока в него не встали */
    .cell { width: 100%; border: 1px solid transparent; background: transparent; padding: 5px 7px;
      border-radius: 7px; font-size: 13.5px; }
    .cell:hover { border-color: var(--bd-1); background: var(--bg-surface); }
    .cell:focus { outline: 0; border-color: var(--accent); background: var(--bg-surface); }
    .cell.saved { border-color: var(--ok) !important; background: var(--accent-soft) !important; }
    .cell.failed { border-color: var(--bad) !important; }

    .badge { display: inline-flex; align-items: center; gap: 5px; font-size: 11.5px; font-weight: 600;
      padding: 3px 9px; border-radius: 999px; white-space: nowrap; }
    .badge .dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
    .icon-btn { border: 1px solid var(--bd-1); background: var(--bg-surface); border-radius: 7px;
      width: 27px; height: 27px; cursor: pointer; color: var(--tx-2); font-size: 14px; line-height: 1; }
    .icon-btn:hover { background: var(--bg-surface-3); color: var(--tx-1); }
    .icon-btn.del:hover { background: rgba(220,38,38,.12); color: var(--bad); border-color: var(--bad); }

    /* ─────────── ФИЛЬТРЫ ─────────── */
    .bar { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-bottom: 16px; }
    .bar input, .bar select { padding: 9px 12px; border: 1px solid var(--bd-2); border-radius: 9px;
      background: var(--bg-surface); color: var(--tx-1); font-size: 13px; }
    .bar input[type=search] { min-width: 230px; }
    .seg { display: inline-flex; background: var(--bg-surface-2); border: 1px solid var(--bd-1);
      border-radius: 10px; padding: 3px; gap: 2px; }
    .seg button { border: 0; background: transparent; padding: 7px 13px; border-radius: 8px; cursor: pointer;
      font-size: 12.5px; font-weight: 600; color: var(--tx-2); }
    .seg button.on { background: var(--bg-surface); color: var(--tx-1); box-shadow: 0 1px 3px rgba(15,23,42,.1); }

    /* ─────────── КАНБАН ─────────── */
    .kanban { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(250px, 1fr); gap: 12px;
      overflow-x: auto; padding-bottom: 10px; align-items: start; }
    .kcol { background: var(--bg-col); border-radius: 14px; padding: 11px; min-height: 120px; }
    .kcol.over { outline: 2px dashed var(--accent); outline-offset: -2px; }
    .kcol-head { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; padding: 0 3px;
      font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--tx-2); }
    .kcol-n { margin-left: auto; background: var(--bg-surface); border-radius: 999px; padding: 1px 8px;
      font-size: 11px; color: var(--tx-3); font-weight: 600; }
    .klist { display: grid; gap: 8px; }
    .kcard { background: var(--bg-surface); border: 1px solid var(--bd-1); border-radius: 11px;
      padding: 11px 13px; cursor: grab; display: grid; gap: 4px; box-shadow: var(--sh-card); }
    .kcard:active { cursor: grabbing; }
    .kcard.dragging { opacity: .4; }
    .kcard .k-name { font-weight: 600; font-size: 13.5px; }
    .kcard .k-contact { font-size: 12.5px; color: var(--tx-2); }
    .kcard .k-meta { font-size: 11.5px; color: var(--tx-3); }
    .kcard .k-amount { font-size: 13px; font-weight: 700; color: var(--ok); }

    /* ─────────── КАРТОЧКИ (плитка) ─────────── */
    .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px; }
    .card { background: var(--bg-surface); border: 1px solid var(--bd-1); border-radius: var(--r-card);
      padding: 16px; box-shadow: var(--sh-card); display: grid; gap: 8px; cursor: pointer; }
    .card:hover { border-color: var(--bd-2); transform: translateY(-1px); }
    .card .c-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }
    .card .c-name { font-weight: 700; font-size: 14.5px; }
    .card .c-row { display: flex; justify-content: space-between; font-size: 12.5px; color: var(--tx-2); }
    .card .c-amount { font-size: 17px; font-weight: 700; }

    /* ─────────── ФОРМА ДОБАВЛЕНИЯ ─────────── */
    .formbox { background: var(--bg-surface); border: 1px solid var(--bd-1); border-radius: var(--r-card);
      padding: 16px; margin-bottom: 16px; display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 10px; box-shadow: var(--sh-card); }
    .formbox[hidden] { display: none; }
    .formbox input, .formbox select, .formbox textarea { padding: 9px 12px; border: 1px solid var(--bd-2);
      border-radius: 9px; background: var(--bg-surface-2); color: var(--tx-1); font-size: 13px; }
    .formbox textarea { grid-column: 1 / -1; resize: vertical; }
    .formbox .f-actions { grid-column: 1 / -1; display: flex; gap: 9px; }

    /* ─────────── КАРТОЧКА-ЛИСТ (детали) ─────────── */
    .modal { position: fixed; inset: 0; background: rgba(8,12,20,.55); backdrop-filter: blur(3px);
      display: flex; align-items: center; justify-content: center; padding: 24px; z-index: 400; }
    .modal[hidden] { display: none; }
    .sheet { background: var(--bg-surface); border-radius: var(--r-card); width: 100%; max-width: 600px;
      max-height: 86vh; overflow: auto; padding: 24px; box-shadow: 0 24px 60px rgba(0,0,0,.28); }
    .sheet h3 { margin: 0 0 4px; font-size: 20px; }
    .sheet .sh-sub { color: var(--tx-2); font-size: 13px; margin: 0 0 18px; }
    .sheet dl { display: grid; grid-template-columns: 150px 1fr; gap: 8px 14px; margin: 0 0 18px; font-size: 13.5px; }
    .sheet dt { color: var(--tx-3); }
    .sheet dd { margin: 0; word-break: break-word; }
    .sheet textarea { width: 100%; min-height: 78px; padding: 10px 12px; border: 1px solid var(--bd-2);
      border-radius: 9px; background: var(--bg-surface-2); color: var(--tx-1); resize: vertical; margin-bottom: 12px; }
    .sheet .sh-actions { display: flex; gap: 9px; flex-wrap: wrap; border-top: 1px solid var(--bd-1); padding-top: 16px; }

    /* ─────────── МЕЛОЧИ ─────────── */
    .hint { color: var(--tx-3); font-size: 13px; margin: 0 0 14px; }

    /* Плашка ошибки загрузки. Цвет — не «тревога ради тревоги»: красная полоса тут
       единственное, что отличает «ничего нет» от «не доехало», и человек не должен
       вглядываться, чтобы это понять */
    .errbox { background: var(--bad-soft, rgba(220,38,38,.07)); border: 1px solid rgba(220,38,38,.28);
      border-radius: var(--r-card); padding: 16px 18px; }
    .errbox b { display: block; margin-bottom: 4px; color: var(--bad); }
    .errbox .hint { margin: 0 0 12px; }

    /* Статистика: три карточки в ряд, на узком экране — в столбик */
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 14px; }
    .sc-card { background: var(--bg-surface); border: 1px solid var(--bd-1); border-radius: var(--r-card);
      box-shadow: var(--sh-card); padding: 16px 18px; }
    .sc-head { display: flex; align-items: center; gap: 9px; margin-bottom: 12px; }
    .sc-badge { width: 26px; height: 26px; border-radius: 8px; color: #fff; display: grid; place-items: center;
      font-size: 11px; font-weight: 700; letter-spacing: -.02em; flex: none; }
    .sc-title { font-weight: 600; font-size: 14px; }
    .sc-when { margin-left: auto; font-size: 11px; color: var(--tx-3); }
    .sc-facts { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 12px; margin-bottom: 12px; }
    .sc-fact span { display: block; font-size: 11px; color: var(--tx-3); }
    .sc-fact b { font-size: 16px; font-variant-numeric: tabular-nums; }
    .sc-chart { margin: 0 -4px; }
    /* Отключённый источник: приглушённый фон, чтобы не путался с рабочим */
    .stat-off { margin: 8px 0 8px; font-size: 13px; color: var(--tx-2); background: var(--bg-surface-3);
      border-radius: 9px; padding: 9px 11px; }
    .sc-card code, .errbox code { font-family: var(--font-mono); font-size: 11.5px; background: var(--bg-surface-3);
      padding: 1px 5px; border-radius: 5px; }
    .warn { color: var(--warn); background: var(--accent-soft); border-radius: 9px; padding: 11px 13px;
      font-size: 12.5px; margin: 12px 0 0; }
    .sumline { color: var(--tx-2); font-size: 13px; margin-top: 12px; }
    .media-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
    .media-grid figure { margin: 0; }
    .media-grid img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 10px; background: var(--bg-surface-3); }
    .media-grid figcaption { font-size: 11.5px; color: var(--tx-3); margin-top: 6px; word-break: break-word; }
    .pre { background: var(--bg-surface); border: 1px solid var(--bd-1); border-radius: var(--r-card);
      padding: 16px; overflow: auto; font-size: 12px; max-height: 400px; font-family: var(--font-mono); }
    /* Скелетон: полосы с бегущим бликом, пока идут данные */
    .skeleton { height: 64px; border-radius: var(--r-card); margin-bottom: 12px;
      background: linear-gradient(90deg, var(--bg-surface-2) 25%, var(--bg-surface-3) 37%, var(--bg-surface-2) 63%);
      background-size: 400% 100%; animation: sk 1.3s ease-in-out infinite; }
    .skeleton:nth-child(2) { height: 120px; }
    .skeleton:nth-child(3) { height: 90px; }
    @keyframes sk { 0% { background-position: 100% 0; } 100% { background-position: -100% 0; } }

    .toast { position: fixed; right: 22px; bottom: 22px; background: var(--tx-1); color: var(--bg-surface);
      padding: 13px 17px; border-radius: 11px; font-size: 13.5px; z-index: 600; cursor: pointer;
      box-shadow: 0 10px 30px rgba(0,0,0,.25); }
    .toast[hidden] { display: none; }

    @media (max-width: 900px) {
      .sb { position: fixed; left: -260px; transition: left .2s; }
      .sb.open { left: 0; }
      .content { padding: 16px 14px 50px; }
      .topbar { padding: 12px 14px; }
      .kanban { grid-auto-columns: minmax(230px, 84vw); }
      .sheet dl { grid-template-columns: 1fr; gap: 2px 0; }
      .sheet dt { margin-top: 8px; }
    }
  </style>
</head>
<body>
  <!-- ═══════════ ВХОД ═══════════ -->
  <div class="login" id="login">
    <form id="login-form">
      <h1>Кабинет</h1>
      <p class="sub">Войдите, чтобы работать с заявками и контентом</p>
      <label>Почта <input type="email" name="email" autocomplete="username" required /></label>
      <label>Пароль <input type="password" name="password" autocomplete="current-password" required /></label>
      <button class="btn" type="submit">Войти</button>
      <p class="err" id="login-err" role="alert"></p>
    </form>
  </div>

  <!-- ═══════════ КАРКАС ═══════════ -->
  <div class="shell" id="shell" hidden>
    <aside class="sb" id="sidebar">
      <div class="sb-brand">
        <div class="sb-logo">С</div>
        <div class="sb-name">Стекляника<small>система учёта</small></div>
      </div>
      <nav id="nav"></nav>
      <div class="sb-foot">
        <div class="sb-user">
          <div class="sb-avatar" id="user-initial">?</div>
          <div>
            <div class="u-name" id="user-name">—</div>
            <div class="u-role" id="user-role">—</div>
          </div>
        </div>
        <div class="theme-switch" id="theme-switch" title="Оформление"></div>
        <button class="btn btn--ghost btn--sm" id="logout" type="button" style="width:100%;margin-top:10px">Выйти</button>
      </div>
    </aside>

    <main class="main">
      <div class="topbar">
        <h1 id="view-title">Обзор</h1>
        <div class="spacer"></div>
        <div id="top-actions"></div>
      </div>
      <div class="content" id="content"></div>
    </main>
  </div>

  <!-- Детали записи поверх экрана -->
  <div class="modal" id="modal" hidden>
    <div class="sheet" id="sheet"></div>
  </div>
  <p class="toast" id="toast" hidden></p>

  <script is:inline>
// ═══════════════════════════════════════════════════════════════════════════════
//  СКРИПТ CRM. Авторизация, загрузка, рендер, действия.
//
//  Правила, которые ломать нельзя:
//  1. Всё, что пришло из базы, идёт в innerHTML ТОЛЬКО через esc(). Иначе XSS.
//  2. Любая ошибка сети показывается человеку, а не глотается.
//  3. Сессия проверяется через /me. Пока её нет — рисуем только форму входа.
// ═══════════════════════════════════════════════════════════════════════════════
(function () {
  'use strict';

  // ─────────── УТИЛИТЫ ───────────
  const $ = (sel, root) => (root || document).querySelector(sel);
  const $$ = (sel, root) => Array.from((root || document).querySelectorAll(sel));

  // Экранируем и одинарную кавычку: значения уходят не только в текст, но и в атрибуты
  const ESC_MAP = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
  const esc = (v) => String(v === null || v === undefined ? '' : v).replace(/[&<>"']/g, (c) => ESC_MAP[c]);

  const money = (v) => (v === null || v === undefined || v === '' ? '—' : Number(v).toLocaleString('ru-RU') + ' ₽');
  const fmtDate = (iso) => {
    if (!iso) return '—';
    const d = new Date(iso);
    if (isNaN(d)) return String(iso);
    return d.toLocaleDateString('ru-RU') + ' ' + d.toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' });
  };
  const today = () => new Date().toISOString().slice(0, 10);

  // ─────────── СОСТОЯНИЕ ───────────
  let me = null;
  let view = null;          // текущий экран
  const cache = {};         // здесь живут загруженные списки, чтобы не дёргать сервер на каждый рендер

  // ─────────── API ───────────
  // auth401: false на ручке логина — там 401 значит «неверный пароль», разлогинивать нечего
  async function api(path, init, opts) {
    init = init || {};
    opts = opts || {};
    const res = await fetch('/api/admin' + path, {
      method: init.method || 'GET',
      body: init.body,
      credentials: 'same-origin',
      headers: init.body ? { 'Content-Type': 'application/json' } : undefined,
    });
    if (res.status === 401 && opts.auth401 !== false) {
      me = null;
      renderAuth();
      throw new Error('unauthorized');
    }
    if (opts.raw) return res;
    return res.json();
  }

  // ─────────── СПРАВОЧНИКИ ───────────
  const LEAD_STATUS = {
    new: { t: 'Новая', c: 'var(--info)' },
    in_progress: { t: 'В работе', c: 'var(--warn)' },
    archived: { t: 'Архив', c: 'var(--tx-3)' },
    spam: { t: 'Спам', c: 'var(--bad)' },
  };
  const APP_STATUS = {
    new: { t: 'Новые', c: 'var(--info)' },
    screened: { t: 'Просмотрен', c: 'var(--warn)' },
    invited: { t: 'Приглашён', c: 'var(--ok)' },
    hired: { t: 'Принят', c: 'var(--ok)' },
    rejected: { t: 'Отказ', c: 'var(--bad)' },
  };
  const VAC_STATUS = { open: 'Открыта', paused: 'Пауза', closed: 'Закрыта' };
  const EMP_STATUS = { active: { t: 'Работает', c: 'var(--ok)' }, prob: { t: 'Испытательный', c: 'var(--warn)' }, fired: { t: 'Уволен', c: 'var(--tx-3)' } };
  const PAY_TYPES = { salary: 'Зарплата', bonus: 'Премия', advance: 'Аванс', vacation: 'Отпускные' };
  const SOCIAL_STATUS = { active: { t: 'Ведётся', c: 'var(--ok)' }, paused: { t: 'Пауза', c: 'var(--warn)' }, closed: { t: 'Закрыта', c: 'var(--tx-3)' } };
  const ROLES_RU = { admin: 'Администратор', hr: 'HR', marketing: 'Маркетолог', viewer: 'Наблюдатель' };

  const badge = (txt, color) =>
    `<span class="badge" style="color:${color};background:color-mix(in srgb, ${color} 12%, transparent)">
      <span class="dot"></span>${esc(txt)}</span>`;

  // ─────────── МЕНЮ ПО РОЛЯМ ───────────
  // У admin всё, у hr и marketing — только свои разделы. Настоящая защита на сервере,
  // здесь лишь прячем то, что человеку не положено видеть
  const NAV = [
    { section: 'Работа', items: [
      { id: 'overview', label: 'Обзор', roles: ['admin', 'hr', 'marketing'],
        icon: '<path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/>' },
      { id: 'leads', label: 'Заявки', roles: ['admin', 'hr', 'marketing'], badge: 'leads',
        icon: '<path d="M4 4h16v4H4zM4 10h16v4H4zM4 16h10v4H4z"/>' },
    ]},
    { section: 'HR', items: [
      { id: 'apps', label: 'Отклики', roles: ['admin', 'hr'], badge: 'apps',
        icon: '<path d="M4 4h16v16H4z"/><path d="M8 9h8M8 13h8M8 17h5"/>' },
      { id: 'vacancies', label: 'Вакансии', roles: ['admin', 'hr'],
        icon: '<path d="M4 8h16v12H4z"/><path d="M9 8V5h6v3"/>' },
      { id: 'employees', label: 'Сотрудники', roles: ['admin', 'hr'],
        icon: '<circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 4-6 8-6s8 2 8 6"/>' },
      { id: 'payments', label: 'Выплаты', roles: ['admin', 'hr'],
        icon: '<path d="M12 2v20M17 6H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>' },
    ]},
    { section: 'Маркетинг', items: [
      { id: 'texts', label: 'Тексты', roles: ['admin', 'marketing'],
        icon: '<path d="M4 4h16v16H4z"/><path d="M8 8h8M8 12h8M8 16h5"/>' },
      { id: 'media', label: 'Медиа', roles: ['admin', 'marketing'],
        icon: '<path d="M3 5h18v14H3z"/><circle cx="8.5" cy="10" r="1.5"/><path d="M21 16l-5-5-4 4-2-2-5 5"/>' },
      { id: 'social', label: 'Соцсети', roles: ['admin', 'marketing'],
        icon: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 3 2.5 15 0 18M12 3c-2.5 3-2.5 15 0 18"/>' },
      { id: 'stats', label: 'Статистика', roles: ['admin', 'marketing'],
        icon: '<path d="M3 3v18h18M7 14l4-4 4 4 6-6"/>' },
    ]},
    { section: 'Система', items: [
      { id: 'users', label: 'Пользователи', roles: ['admin'],
        icon: '<path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M9 2h6v4H9z"/>' },
      { id: 'audit', label: 'Журнал', roles: ['admin'],
        icon: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/>' },
    ]},
  ];

  const TITLES = {
    overview: 'Обзор', leads: 'Заявки', apps: 'Отклики', vacancies: 'Вакансии',
    employees: 'Сотрудники', payments: 'Выплаты', texts: 'Тексты сайта',
    media: 'Медиатека', social: 'Группы соцсетей', stats: 'Статистика',
    users: 'Пользователи', audit: 'Журнал действий',
  };

  // ─────────── ТЕМЫ ───────────
  const THEMES = [
    { id: 'apple', name: 'Apple', color: '#0071E3' },
    { id: 'vk', name: 'ВКонтакте', color: '#0077FF' },
    { id: 'bitrix', name: 'Bitrix', color: '#2E8BFF' },
    { id: 'erp', name: 'ERP', color: '#1A56DB' },
    { id: 'skatinov', name: 'Бренд', color: '#7fd1ff' },
    { id: 'dark', name: 'Тёмная', color: '#0E1016' },
  ];

  function initTheme() {
    const box = $('#theme-switch');
    box.innerHTML = THEMES.map((t) =>
      `<button type="button" data-theme-id="${t.id}" title="${esc(t.name)}"
        style="background:${t.color}"></button>`).join('');
    const saved = localStorage.getItem('crm-theme') || 'apple';
    setTheme(saved);
    $$('[data-theme-id]', box).forEach((b) => {
      b.addEventListener('click', () => setTheme(b.dataset.themeId));
    });
  }
  function setTheme(id) {
    document.documentElement.setAttribute('data-theme', id);
    localStorage.setItem('crm-theme', id);
    $$('[data-theme-id]').forEach((b) => b.classList.toggle('on', b.dataset.themeId === id));
  }

  // ─────────── ВХОД ───────────
  function renderAuth() {
    $('#login').hidden = !!me;
    $('#shell').hidden = !me;
    if (!me) return;

    $('#user-name').textContent = me.name || me.email;
    $('#user-role').textContent = ROLES_RU[me.role] || me.role;
    $('#user-initial').textContent = (me.name || me.email).trim().charAt(0).toUpperCase();

    // Меню: только разделы своей роли
    const nav = $('#nav');
    nav.innerHTML = NAV.map((group) => {
      const items = group.items.filter((it) => me.role === 'admin' || it.roles.includes(me.role));
      if (!items.length) return '';
      return `<div class="sb-section">${esc(group.section)}</div>` + items.map((it) =>
        `<button class="sb-item" data-view="${it.id}">
          <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">${it.icon}</svg>
          <span>${esc(it.label)}</span>
          ${it.badge ? `<span class="sb-badge" id="badge-${it.badge}" hidden>0</span>` : ''}
        </button>`).join('');
    }).join('');

    $$('.sb-item').forEach((b) => b.addEventListener('click', () => switchView(b.dataset.view)));

    const first = $$('.sb-item')[0];
    switchView(first ? first.dataset.view : 'overview');
    refreshCounters();
    // Опрос раз в минуту: заявки не идут потоком, а лишние запросы мешают читать логи
    setInterval(refreshCounters, 60000);
  }

  $('#login-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(e.currentTarget);
    const err = $('#login-err');
    err.textContent = '';
    try {
      const res = await api('/login', {
        method: 'POST',
        body: JSON.stringify({ email: fd.get('email'), password: fd.get('password') }),
      }, { auth401: false });
      if (!res.ok) {
        // 429 — это лимит попыток, а не неверный пароль. Врать человеку нельзя
        err.textContent = res.error === 'too_many_requests'
          ? 'Слишком много попыток входа. Подождите минуту'
          : 'Неверная почта или пароль';
        return;
      }
      await boot();
      if (!me) err.textContent = 'Вход прошёл, но браузер не сохранил сессию. Адрес должен быть http://localhost:4321';
    } catch (ex) {
      err.textContent = 'Сервер не отвечает';
    }
  });

  $('#logout').addEventListener('click', async () => {
    await api('/logout', { method: 'POST' }).catch(() => {});
    me = null;
    renderAuth();
  });

  async function refreshCounters() {
    const c = await api('/counters').catch(() => null);
    if (!c || !c.ok) return;
    const put = (id, n) => {
      const el = $('#badge-' + id);
      if (!el) return;
      el.textContent = n;
      el.hidden = n === 0;
    };
    put('leads', c.leads_new);
    put('apps', c.apps_new);
    document.title = c.leads_new > 0 ? '(' + c.leads_new + ') Кабинет' : 'Кабинет';
  }

  // ─────────── ПЕРЕКЛЮЧЕНИЕ ЭКРАНОВ ───────────
  function switchView(id) {
    view = id;
    $$('.sb-item').forEach((b) => b.classList.toggle('on', b.dataset.view === id));
    $('#view-title').textContent = TITLES[id] || id;
    $('#top-actions').innerHTML = '';
    // Скелетон из трёх полос вместо надписи «Загрузка…»: видно, что страница живая,
    // и не приходится гадать, идёт запрос или всё подвисло
    $('#content').innerHTML = '<div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div>';
    const fn = VIEWS[id];
    if (fn) fn();
    else $('#content').innerHTML = '<p class="hint">Раздел в разработке</p>';
  }

  // ─────────── ОБЗОР ───────────
  async function viewOverview() {
    const [leads, apps, social] = await Promise.all([
      api('/leads?limit=200').catch(() => ({ items: [] })),
      api('/applications').catch(() => ({ items: [] })),
      api('/social').catch(() => ({ items: [] })),
    ]);
    const L = leads.items || [];
    const A = apps.items || [];
    const newLeads = L.filter((l) => l.status === 'new').length;
    const inWork = L.filter((l) => l.status === 'in_progress').length;
    const total = L.reduce((s, l) => s + (Number(l.amount) || 0), 0);
    const newApps = A.filter((a) => a.status === 'new').length;

    $('#content').innerHTML = `
      <div class="kpis">
        <div class="kpi" style="cursor:pointer" data-goto="leads"><div class="k-label">Новые заявки</div>
          <div class="k-val">${newLeads}</div><div class="k-sub">ждут первого звонка</div></div>
        <div class="kpi"><div class="k-label">В работе</div><div class="k-val">${inWork}</div>
          <div class="k-sub">взяты менеджером</div></div>
        <div class="kpi"><div class="k-label">Сумма заявок</div><div class="k-val">${total.toLocaleString('ru-RU')} ₽</div>
          <div class="k-sub">по всем, включая архив</div></div>
        <div class="kpi" style="cursor:pointer" data-goto="apps"><div class="k-label">Новые отклики</div>
          <div class="k-val">${newApps}</div><div class="k-sub">на вакансии</div></div>
      </div>
      <h2 style="font-size:16px;margin:0 0 12px">Последние заявки</h2>
      <div class="tbl-wrap"><table class="tbl">
        <thead><tr><th>Дата</th><th>Клиент</th><th>Объект</th><th class="num">Сумма</th><th>Статус</th></tr></thead>
        <tbody>${L.slice(0, 8).map((l) => `<tr>
          <td class="nowrap muted">${esc(fmtDate(l.created_at))}</td>
          <td><b>${esc(l.name) || 'Без имени'}</b><div class="muted">${esc(l.contact)}</div></td>
          <td>${esc(l.object) || '<span class="muted">—</span>'}</td>
          <td class="num">${money(l.amount)}</td>
          <td>${badge(LEAD_STATUS[l.status] ? LEAD_STATUS[l.status].t : l.status, LEAD_STATUS[l.status] ? LEAD_STATUS[l.status].c : 'var(--tx-3)')}</td>
        </tr>`).join('') || '<tr><td colspan="5" class="empty">Заявок нет</td></tr>'}</tbody>
      </table></div>

      ${(() => {
        // «Требует внимания»: заявки старше двух суток в статусе new. Это то, что реально
        // теряется — клиент написал, а менеджер не позвонил. Считаем на клиенте, сервер тут не нужен
        const stale = L.filter((l) => l.status === 'new' &&
          Date.now() - new Date(l.created_at).getTime() > 2 * 86400000);
        if (!stale.length) return '';
        return `<div class="warn" style="margin-bottom:20px">
          <b>Требуют внимания: ${stale.length}</b> — заявки висят в статусе «Новая» больше двух суток.
          ${stale.slice(0, 3).map((l) => esc(l.name) || 'без имени').join(', ')}${stale.length > 3 ? ' и другие' : ''}
        </div>`;
      })()}

      <h2 style="font-size:16px;margin:24px 0 12px">Группы соцсетей</h2>
      <div class="kpis">${(social.items || []).map((g) => `
        <div class="kpi"><div class="k-label">${esc(g.net)}</div>
          <div class="k-val">${Number(g.members).toLocaleString('ru-RU')}</div>
          <div class="k-sub">${esc(g.name)} · вовлечённость ${g.engagement}%</div></div>`).join('')
        || '<p class="hint">Групп пока нет</p>'}</div>`;

    // Клик по плитке ведёт в раздел: меньше движений мышью
    $$('[data-goto]').forEach((el) => {
      el.addEventListener('click', () => switchView(el.dataset.goto));
    });
  }

  // ─────────── ЗАЯВКИ: 4 РЕЖИМА ───────────
  // Режим храним в localStorage: человек привыкает к одному виду и не хочет
  // каждый раз переключать заново
  let leadMode = localStorage.getItem('crm-leads-mode') || 'table';
  let leadSort = { key: 'created_at', dir: -1 };

  async function viewLeads() {
    $('#content').innerHTML = `
      <div class="bar">
        <div class="seg" id="lead-mode">
          <button data-mode="table">Таблица</button>
          <button data-mode="kanban">Канбан</button>
          <button data-mode="cards">Карточки</button>
          <button data-mode="archive">Архив</button>
        </div>
        <input id="f-q" type="search" placeholder="Имя, контакт или объект" />
        <select id="f-status">
          <option value="">Все статусы</option>
          ${Object.keys(LEAD_STATUS).map((k) => `<option value="${k}">${LEAD_STATUS[k].t}</option>`).join('')}
        </select>
        <select id="f-source">
          <option value="">Все источники</option>
          <option value="modal">Окно заявки</option>
          <option value="quiz">Квиз</option>
          <option value="contacts">Контакты</option>
          <option value="resume">Резюме</option>
          <option value="manual">Заведена вручную</option>
        </select>
        <button class="btn" id="lead-add" type="button">Добавить</button>
        <a class="btn btn--ghost" href="/api/admin/leads/export">Выгрузить</a>
      </div>
      <form class="formbox" id="lead-form" hidden>
        <input name="name" placeholder="Имя клиента" required />
        <input name="contact" placeholder="Телефон или почта" required />
        <input name="object" placeholder="Объект" />
        <input name="amount" type="number" min="0" step="1000" placeholder="Сумма, ₽" />
        <select name="status">
          <option value="new">Новая</option><option value="in_progress">В работе</option>
        </select>
        <textarea name="comment" rows="2" placeholder="Примечание"></textarea>
        <div class="f-actions">
          <button class="btn" type="submit">Сохранить</button>
          <button class="btn btn--ghost" type="button" id="lead-cancel">Отмена</button>
        </div>
      </form>
      <div id="lead-area"><p class="hint">Загрузка…</p></div>`;

    $$('#lead-mode button').forEach((b) => {
      b.classList.toggle('on', b.dataset.mode === leadMode);
      b.addEventListener('click', () => {
        leadMode = b.dataset.mode;
        localStorage.setItem('crm-leads-mode', leadMode);
        $$('#lead-mode button').forEach((x) => x.classList.toggle('on', x.dataset.mode === leadMode));
        drawLeads();
      });
    });

    let t;
    ['#f-q', '#f-status', '#f-source'].forEach((sel) => {
      const el = $(sel);
      el.addEventListener('input', () => {
        clearTimeout(t);
        t = setTimeout(loadLeads, sel === '#f-q' ? 350 : 0);
      });
    });

    $('#lead-add').addEventListener('click', () => {
      const f = $('#lead-form');
      f.hidden = !f.hidden;
      if (!f.hidden) $('[name=name]', f).focus();
    });
    $('#lead-cancel').addEventListener('click', () => { $('#lead-form').hidden = true; });
    $('#lead-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.currentTarget;
      const body = {};
      new FormData(form).forEach((v, k) => { if (v !== '') body[k] = v; });
      await api('/leads', { method: 'POST', body: JSON.stringify(body) }).catch(() => {});
      form.reset();
      form.hidden = true;
      loadLeads();
      refreshCounters();
    });

    loadLeads();
  }

  async function loadLeads() {
    const q = $('#f-q') ? $('#f-q').value.trim() : '';
    const st = $('#f-status') ? $('#f-status').value : '';
    const src = $('#f-source') ? $('#f-source').value : '';
    const p = new URLSearchParams();
    if (q) p.set('q', q);
    if (st) p.set('status', st);
    if (src) p.set('source', src);
    // Ошибку НЕ превращаем в пустой список. Раньше здесь стоял .catch(() => ({ items: [] }))
    // и получалось худшее из возможного: бейдж «2 новые» горит, а таблица пустая — будто
    // заявки потерялись. Пустой список и упавший запрос должны выглядеть по-разному
    try {
      const res = await api('/leads?' + p.toString());
      if (!res || res.ok === false) throw new Error((res && res.error) || 'bad_response');
      cache.leads = res.items || [];
      cache.leadsError = null;
    } catch (e) {
      if (String(e && e.message) === 'unauthorized') return;
      cache.leads = [];
      cache.leadsError = String((e && e.message) || 'unknown');
    }
    drawLeads();
  }

  function drawLeads() {
    const area = $('#lead-area');
    if (!area) return;
    // Список не загрузился — говорим прямо и даём кнопку. Молчаливая пустота хуже ошибки:
    // человек начинает думать, что заявки удалились
    if (cache.leadsError) {
      area.innerHTML = `<div class="errbox">
        <b>Не удалось загрузить заявки.</b>
        <p class="hint">Ответ сервера: ${esc(cache.leadsError)}. Счётчики при этом живые — данные на месте, упал запрос списка.</p>
        <button class="btn" type="button" id="lead-retry">Повторить</button>
      </div>`;
      const btn = $('#lead-retry');
      if (btn) btn.addEventListener('click', loadLeads);
      return;
    }
    const all = cache.leads || [];

    if (leadMode === 'table') {
      const sorted = all.slice().sort((a, b) => {
        const x = a[leadSort.key], y = b[leadSort.key];
        if (x === null || x === undefined) return 1;
        if (y === null || y === undefined) return -1;
        const cmp = typeof x === 'number' && typeof y === 'number'
          ? x - y : String(x).localeCompare(String(y), 'ru');
        return cmp * leadSort.dir;
      });
      const total = all.reduce((s, l) => s + (Number(l.amount) || 0), 0);
      area.innerHTML = `<div class="tbl-wrap"><table class="tbl" id="lead-tbl">
        <thead><tr>
          <th data-sort="created_at">Дата</th><th data-sort="name">Клиент</th>
          <th data-sort="object">Объект</th><th data-sort="amount" class="num">Сумма</th>
          <th data-sort="status">Статус</th><th data-sort="assigned_to">Ответственный</th><th></th>
        </tr></thead>
        <tbody>${sorted.map(leadRow).join('') ||
          '<tr><td colspan="7" class="empty">Заявок нет. Измените фильтры или добавьте вручную.</td></tr>'}</tbody>
      </table></div>
      <p class="sumline">Заявок: ${all.length}. Сумма: ${total.toLocaleString('ru-RU')} ₽</p>`;
      wireLeadTable();
      $$('#lead-tbl th[data-sort]').forEach((th) => {
        th.classList.toggle('sorted-desc', leadSort.key === th.dataset.sort && leadSort.dir === -1);
        th.classList.toggle('sorted-asc', leadSort.key === th.dataset.sort && leadSort.dir === 1);
        th.addEventListener('click', () => {
          const k = th.dataset.sort;
          if (leadSort.key === k) leadSort.dir = leadSort.dir === -1 ? 1 : -1;
          else leadSort = { key: k, dir: k === 'created_at' || k === 'amount' ? -1 : 1 };
          drawLeads();
        });
      });
      return;
    }

    if (leadMode === 'kanban') {
      const cols = Object.keys(LEAD_STATUS);
      area.innerHTML = `<div class="kanban">${cols.map((s) => {
        const inCol = all.filter((l) => l.status === s);
        return `<div class="kcol" data-status="${s}">
          <div class="kcol-head"><span class="dot" style="width:7px;height:7px;border-radius:50%;background:${LEAD_STATUS[s].c}"></span>
            ${LEAD_STATUS[s].t}<span class="kcol-n">${inCol.length}</span></div>
          <div class="klist">${inCol.map((l) => `
            <article class="kcard" draggable="true" data-id="${esc(l.id)}">
              <div class="k-name">${esc(l.name) || 'Без имени'}</div>
              <div class="k-contact">${esc(l.contact)}</div>
              ${l.object ? `<div class="k-meta">${esc(l.object)}</div>` : ''}
              <div class="k-amount">${money(l.amount)}</div>
            </article>`).join('') || '<p class="hint" style="margin:6px">Пусто</p>'}</div>
        </div>`;
      }).join('')}</div>`;
      wireKanban(area, function (id, status) {
        const item = (cache.leads || []).find((l) => l.id === id);
        if (item) item.status = status;
        drawLeads();
      });
      return;
    }

    if (leadMode === 'cards') {
      area.innerHTML = `<div class="cards">${all.map((l) => `
        <div class="card" data-open="${esc(l.id)}">
          <div class="c-top">
            <div class="c-name">${esc(l.name) || 'Без имени'}</div>
            ${badge(LEAD_STATUS[l.status] ? LEAD_STATUS[l.status].t : l.status,
              LEAD_STATUS[l.status] ? LEAD_STATUS[l.status].c : 'var(--tx-3)')}
          </div>
          <div class="c-amount">${money(l.amount)}</div>
          <div class="c-row"><span>${esc(l.object) || 'Объект не указан'}</span></div>
          <div class="c-row"><span>${esc(l.contact)}</span><span>${esc(fmtDate(l.created_at))}</span></div>
        </div>`).join('') || '<p class="hint">Заявок нет</p>'}</div>`;
      wireOpenCards(area);
      return;
    }

    // Архив: только завершённые и спам, отдельно от рабочего списка
    const arch = all.filter((l) => l.status === 'archived' || l.status === 'spam');
    area.innerHTML = `<div class="tbl-wrap"><table class="tbl">
      <thead><tr><th>Дата</th><th>Клиент</th><th>Объект</th><th class="num">Сумма</th><th>Статус</th><th>Заметка</th><th></th></tr></thead>
      <tbody>${arch.map((l) => `<tr>
        <td class="nowrap muted">${esc(fmtDate(l.created_at))}</td>
        <td><b>${esc(l.name)}</b><div class="muted">${esc(l.contact)}</div></td>
        <td>${esc(l.object) || '<span class="muted">—</span>'}</td>
        <td class="num">${money(l.amount)}</td>
        <td>${badge(LEAD_STATUS[l.status].t, LEAD_STATUS[l.status].c)}</td>
        <td class="muted">${esc(l.comment) || '—'}</td>
        <td><button class="icon-btn" data-open="${esc(l.id)}" title="Открыть">⋯</button></td>
      </tr>`).join('') || '<tr><td colspan="7" class="empty">В архиве пусто</td></tr>'}</tbody>
    </table></div>`;
    wireOpenCards(area);
  }

  function leadRow(l) {
    return `<tr data-id="${esc(l.id)}">
      <td class="nowrap muted">${esc(fmtDate(l.created_at))}</td>
      <td>
        <input class="cell" data-field="name" value="${esc(l.name)}" />
        <div class="muted" style="padding:0 7px">${esc(l.contact)} · ${esc(l.source)}</div>
      </td>
      <td><input class="cell" data-field="object" value="${esc(l.object || '')}" placeholder="—" /></td>
      <td class="num"><input class="cell num" data-field="amount" type="number" min="0" step="1000"
            value="${l.amount === null || l.amount === undefined ? '' : l.amount}" placeholder="—" /></td>
      <td><select class="cell" data-field="status">
        ${Object.keys(LEAD_STATUS).map((k) =>
          `<option value="${k}"${l.status === k ? ' selected' : ''}>${LEAD_STATUS[k].t}</option>`).join('')}
      </select></td>
      <td><input class="cell" data-field="assigned_to" value="${esc(l.assigned_to || '')}" placeholder="—" /></td>
      <td class="nowrap" style="text-align:right">
        <button class="icon-btn" data-open="${esc(l.id)}" title="Все поля">⋯</button>
        ${me.role === 'admin' ? `<button class="icon-btn del" data-del="${esc(l.id)}" title="Удалить">×</button>` : ''}
      </td>
    </tr>`;
  }

  function wireLeadTable() {
    $$('#lead-tbl .cell').forEach((el) => {
      el.addEventListener('change', async () => {
        const tr = el.closest('tr');
        const field = el.dataset.field;
        const raw = el.value;
        const val = field === 'amount' ? (raw === '' ? '' : Number(raw)) : raw;
        const body = {};
        body[field] = val;
        try {
          await api('/leads/' + tr.dataset.id, { method: 'PATCH', body: JSON.stringify(body) });
          const item = (cache.leads || []).find((l) => l.id === tr.dataset.id);
          if (item) item[field] = val;
          el.classList.add('saved');
          setTimeout(() => el.classList.remove('saved'), 900);
          if (field === 'status' || field === 'amount') drawLeads();
          refreshCounters();
        } catch (e) {
          el.classList.add('failed');
          setTimeout(() => el.classList.remove('failed'), 1500);
        }
      });
    });
    wireOpenCards($('#lead-tbl'));
    $$('#lead-tbl [data-del]').forEach((b) => {
      b.addEventListener('click', async () => {
        if (!confirm('Удалить заявку безвозвратно?')) return;
        await api('/leads/' + b.dataset.del, { method: 'DELETE' }).catch(() => {});
        loadLeads();
        refreshCounters();
      });
    });
  }

  function wireOpenCards(root) {
    $$('[data-open]', root).forEach((el) => {
      el.addEventListener('click', (e) => {
        if (e.target.closest('input, select, textarea')) return;
        const item = (cache.leads || []).find((l) => l.id === el.dataset.open);
        if (item) openLead(item);
      });
    });
  }

  // Перетаскивание в канбане. Оптимистично меняем в памяти и перерисовываем сразу:
  // ждать сеть на каждом броске — это задержка, из-за которой кажется, что не работает
  function wireKanban(root, onDrop) {
    let dragId = null;
    let wasDragging = false;   // после переноса клик не должен открывать карточку
    $$('.kcard', root).forEach((card) => {
      card.addEventListener('dragstart', () => {
        dragId = card.dataset.id;
        wasDragging = true;
        card.classList.add('dragging');
      });
      card.addEventListener('dragend', () => {
        card.classList.remove('dragging');
        // Сбрасываем флаг не сразу, а после того как браузер отработает click
        setTimeout(() => { wasDragging = false; }, 60);
      });
      card.addEventListener('click', () => {
        if (wasDragging) return;
        const item = (cache.leads || []).find((l) => l.id === card.dataset.id);
        if (item) openLead(item);
      });
    });
    $$('.kcol', root).forEach((col) => {
      col.addEventListener('dragover', (e) => { e.preventDefault(); col.classList.add('over'); });
      col.addEventListener('dragleave', () => col.classList.remove('over'));
      col.addEventListener('drop', async (e) => {
        e.preventDefault();
        col.classList.remove('over');
        if (!dragId) return;
        const status = col.dataset.status;
        const item = (cache.leads || []).find((l) => l.id === dragId);
        if (!item || item.status === status) return;
        const prev = item.status;
        onDrop(dragId, status);
        try {
          await api('/leads/' + dragId, { method: 'PATCH', body: JSON.stringify({ status: status }) });
          refreshCounters();
        } catch (err) {
          onDrop(dragId, prev); // сеть отвалилась — возвращаем, иначе интерфейс врёт
        }
        dragId = null;
      });
    });
  }

  // ─────────── ДЕТАЛИ ЗАЯВКИ ───────────
  function openLead(l) {
    const rows = [];
    rows.push(['Когда', esc(fmtDate(l.created_at))]);
    rows.push(['Источник', esc(l.source) + (l.page ? ' · ' + esc(l.page) : '')]);
    rows.push(['Контакт', esc(l.contact) || '—']);
    rows.push(['Объект', esc(l.object) || '—']);
    rows.push(['Сумма', money(l.amount)]);
    rows.push(['Статус', LEAD_STATUS[l.status] ? LEAD_STATUS[l.status].t : esc(l.status)]);
    // payload — вся форма с сайта. Показываем, чтобы менеджер не спрашивал то, что клиент уже написал
    try {
      const p = JSON.parse(l.payload || '{}');
      Object.keys(p).forEach((k) => {
        const v = p[k];
        if (!v || k === 'name' || k === 'contact') return;
        rows.push([esc(k), esc(typeof v === 'object' ? JSON.stringify(v) : v)]);
      });
    } catch (e) { /* битый payload — не повод не открыть карточку */ }

    openSheet(`<h3>${esc(l.name) || 'Без имени'}</h3>
      <p class="sh-sub">${esc(l.contact)}</p>
      <dl>${rows.map((r) => `<dt>${r[0]}</dt><dd>${r[1]}</dd>`).join('')}</dl>
      <textarea id="sh-comment" placeholder="Заметка: что обсудили, когда перезвонить">${esc(l.comment || '')}</textarea>
      <div class="sh-actions">
        <button class="btn" id="sh-save" type="button">Сохранить заметку</button>
        <a class="btn btn--ghost" href="tel:${esc(l.contact)}">Позвонить</a>
        <button class="btn btn--ghost" id="sh-close" type="button">Закрыть</button>
      </div>`);

    $('#sh-close').addEventListener('click', closeSheet);
    $('#sh-save').addEventListener('click', async () => {
      const comment = $('#sh-comment').value.trim();
      await api('/leads/' + l.id, { method: 'PATCH', body: JSON.stringify({ comment: comment }) });
      l.comment = comment;
      closeSheet();
      loadLeads();
    });
  }

  function openSheet(html) {
    $('#sheet').innerHTML = html;
    $('#modal').hidden = false;
  }
  function closeSheet() { $('#modal').hidden = true; }
  $('#modal').addEventListener('click', (e) => { if (e.target === $('#modal')) closeSheet(); });

  // Esc закрывает карточку, «/» ставит курсор в поиск. Менеджер работает с клавиатуры
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeSheet();
    if (e.key === '/' && document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'TEXTAREA') {
      const q = $('#f-q');
      if (q) { e.preventDefault(); q.focus(); }
    }
  });

  // ─────────── ОТКЛИКИ (канбан) ───────────
  async function viewApps() {
    // Падение запроса не рисуем как «откликов нет»: пустой канбан и сломанный запрос — разное
    const res = await api('/applications').catch((e) => ({ items: [], fail: String((e && e.message) || 'ошибка') }));
    cache.apps = res.items || [];
    const cols = Object.keys(APP_STATUS);
    $('#content').innerHTML = `${res.fail ? `<div class="errbox"><b>Не удалось загрузить отклики.</b>
        <p class="hint">Ответ сервера: ${esc(res.fail)}</p></div>` : ''}<p class="hint">Перетащите карточку, чтобы сменить стадию. Резюме открывается по ссылке.</p>
      <div class="kanban">${cols.map((s) => {
        const inCol = cache.apps.filter((a) => a.status === s);
        return `<div class="kcol" data-status="${s}">
          <div class="kcol-head"><span class="dot" style="width:7px;height:7px;border-radius:50%;background:${APP_STATUS[s].c}"></span>
            ${APP_STATUS[s].t}<span class="kcol-n">${inCol.length}</span></div>
          <div class="klist">${inCol.map((a) => `
            <article class="kcard" draggable="true" data-id="${esc(a.id)}">
              <div class="k-name">${esc(a.name) || 'Без имени'}</div>
              <div class="k-contact">${esc(a.contact)}</div>
              <div class="k-meta">${esc(a.vacancy_slug || a.source)}</div>
              ${a.resume_url ? `<a href="/api/admin/files/${esc(a.resume_url)}" target="_blank" rel="noopener" style="font-size:12px">Резюме</a>` : ''}
            </article>`).join('') || '<p class="hint" style="margin:6px">Пусто</p>'}</div>
        </div>`;
      }).join('')}</div>`;

    let dragId = null;
    $$('.kcard').forEach((card) => {
      card.addEventListener('dragstart', () => { dragId = card.dataset.id; card.classList.add('dragging'); });
      card.addEventListener('dragend', () => card.classList.remove('dragging'));
    });
    $$('.kcol').forEach((col) => {
      col.addEventListener('dragover', (e) => { e.preventDefault(); col.classList.add('over'); });
      col.addEventListener('dragleave', () => col.classList.remove('over'));
      col.addEventListener('drop', async (e) => {
        e.preventDefault();
        col.classList.remove('over');
        if (!dragId) return;
        const item = cache.apps.find((a) => a.id === dragId);
        if (!item || item.status === col.dataset.status) { dragId = null; return; }
        await api('/applications/' + dragId, { method: 'PATCH', body: JSON.stringify({ status: col.dataset.status }) })
          .catch(() => {});
        dragId = null;
        viewApps();
        refreshCounters();
      });
    });
  }

  // ─────────── ВАКАНСИИ ───────────
  async function viewVacancies() {
    const [hh, vac] = await Promise.all([
      api('/hh/status').catch(() => null),
      api('/vacancies').catch(() => ({ items: [] })),
    ]);
    const hhText = !hh || !hh.ok ? 'Статус недоступен'
      : hh.configured
        ? (hh.connected ? 'Подключено к HH' : 'Ключи есть, авторизация не пройдена')
        : 'Ключи приложения не заданы (HH_CLIENT_ID и HH_CLIENT_SECRET в .env)';

    $('#content').innerHTML = `
      <div class="formbox" style="display:block">
        <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
          <b>HH.ru</b><span class="hint" style="margin:0">${esc(hhText)}</span>
          <span style="margin-left:auto;display:flex;gap:9px">
            <a class="btn btn--ghost btn--sm" href="/api/admin/hh/auth" target="_blank" rel="noopener">Подключить</a>
            <button class="btn btn--ghost btn--sm" id="hh-sync" type="button">Синхронизировать</button>
          </span>
        </div>

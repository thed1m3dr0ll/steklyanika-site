# Скопируй в .env и заполни. В git .env не попадает (см. .gitignore)

# ---- Сервер ----
API_PORT=8787
DB_PATH=./data/steklyanika.db
UPLOAD_DIR=./data/uploads
MEDIA_DIR=./data/media

# Соль для хеша IP в журнале согласий. ОБЯЗАТЕЛЬНО поменяй на свою случайную строку.
# Не трогай после запуска: все старые хеши перестанут биться с новыми
IP_SALT=CHANGE_ME_RANDOM_64_CHARS

# production включает флаг Secure у cookie сессии. По http://localhost браузер такую cookie
# молча выбрасывает: вход проходит, а кабинет остаётся на форме логина. Локально всегда development.
# На боевом сервере с https — production
NODE_ENV=development

# ---- Яндекс Метрика (для дашборда маркетолога) ----
# OAuth-токен с правами на чтение статистики, счётчик — номер из кабинета Метрики
YM_TOKEN=
YM_COUNTER=

# ---- HH.ru (для HR-кабинета) ----
# Регистрация приложения: https://dev.hh.ru/admin
# redirect_uri в настройках приложения указать ровно такой:
#   http://localhost:8787/api/admin/hh/callback  (локально)
#   https://steklyanika.ru/api/admin/hh/callback (боевой)
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=http://localhost:8787/api/admin/hh/callback
# Контакт для User-Agent: HH просит представляться, иначе может резать запросы
HH_CONTACT=admin@steklyanika.ru

# ВАЖНО: получение откликов у HH платное (пакеты запросов).
# Список коллекций бесплатный, сами отклики тарифицируются. Считайте бюджет заранее!

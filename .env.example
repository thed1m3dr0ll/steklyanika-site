# Скопируй в .env и заполни. В git .env не попадает (см. .gitignore)

# ---- Сервер ----
API_PORT=8787
DB_PATH=./data/steklyanika.db
UPLOAD_DIR=./data/uploads
MEDIA_DIR=./data/media

# Соль для хеша IP в журнале согласий. ОБЯЗАТЕЛЬНО поменяй на свою случайную строку.
# Не трогай после запуска: все старые хеши перестанут биться с новыми
IP_SALT=CHANGE_ME_RANDOM_64_CHARS

NODE_ENV=production

# ---- Яндекс Метрика (для дашборда маркетолога) ----
# OAuth-токен с правами на чтение статистики, счётчик — номер из кабинета Метрики
YM_TOKEN=
YM_COUNTER=

# ---- HH.ru (для HR-кабинета) ----
# Регистрация приложения: https://dev.hh.ru/admin
HH_CLIENT_ID=
HH_CLIENT_SECRET=
# refresh-токен получается один раз при авторизации, дальше обновляется автоматически
HH_REFRESH_TOKEN=
